{
  "compilerOptions": {
    "target": "ES2022", "module": "Preserve", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true,
    "lib": ["ES2022", "DOM"], "esModuleInterop": true,
    "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "projects/**/*.ts", "projects/**/*.tsx"]
}
